@{
    Layout = null;
}
@model WMS.Terminal.Models.BarcodeViewModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <title>Штрих-коды склада - ТСД Автосклад</title>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f5f5f5;
            padding: 20px;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            margin: -20px -20px 20px -20px;
            padding: 20px;
            color: white;
        }

        .back-btn {
            background: rgba(255,255,255,0.2);
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            color: white;
            margin-bottom: 10px;
            cursor: pointer;
        }

        h1 {
            font-size: 24px;
        }

        .barcode-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        .barcode-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .barcode-label {
            font-size: 14px;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }

        .barcode-image {
            width: 100%;
            max-width: 250px;
            height: auto;
        }

        .barcode-code {
            font-size: 12px;
            color: #999;
            margin-top: 8px;
            font-family: monospace;
        }

        .print-btn {
            background: #28a745;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            font-size: 16px;
            cursor: pointer;
            margin: 20px 0;
            width: 100%;
        }

            .print-btn:active {
                transform: scale(0.98);
            }

        .section-title {
            margin: 20px 0 15px 0;
            font-size: 18px;
            color: #333;
            border-bottom: 2px solid #667eea;
            padding-bottom: 10px;
        }

        .empty {
            text-align: center;
            padding: 30px;
            color: #999;
        }

        @@media print {
            body {
                background: white;
                padding: 10px;
            }

            .header {
                margin: -10px -10px 10px -10px;
                padding: 15px;
            }

            .back-btn, .print-btn {
                display: none;
            }

            .barcode-card {
                break-inside: avoid;
                box-shadow: none;
                border: 1px solid #ddd;
            }
        }

        .copy-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 4px;
            color: #667eea;
            transition: background-color 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .copy-btn:hover {
                background-color: #e8f0fe;
            }

            .copy-btn:active {
                transform: scale(0.9);
            }
    </style>
</head>
<body>
    <div class="header">
        <button class="back-btn" onclick="history.back()">← Назад</button>
        <h1>🏷️ Штрих-коды склада</h1>
    </div>

    <button class="print-btn" onclick="window.print()">🖨️ Печать штрих-кодов</button>

    <div class="section-title">📦 Товары на складе</div>
    @if (Model.Products.Any())
    {
        <div class="barcode-grid">
            @foreach (var item in Model.Products)
            {
                <div class="barcode-card">
                    <div class="barcode-label">@item.Name</div>
                    <svg id="barcode-@item.Barcode" class="barcode-image"></svg>
                    <div class="barcode-code">Артикул: @item.Sku</div>
                    <div class="barcode-code" style="font-size: 10px; color: #667eea;">
                        Штрих-код: @item.Barcode
                        <button class="copy-btn" onclick="copyBarcode('@item.Barcode', this)" title="Скопировать штрих-код">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                            </svg>
                        </button>
                    </div>
                    <div style="font-size: 12px; color: #4caf50;">📍 @item.CellAddress</div>
                    <script>
                        try {
                            JsBarcode("#barcode-@item.Barcode", "@item.Barcode", {
                                format: "EAN13",
                                width: 2,
                                height: 80,
                                displayValue: true,
                                fontSize: 14,
                                margin: 10
                            });
                        } catch(e) { console.log('Ошибка:', e); }
                    </script>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty">📭 Нет товаров на складе</div>
    }

    <div class="section-title">📍 Ячейки склада</div>
    @if (Model.Cells.Any())
    {
        <div class="barcode-grid">
            @foreach (var cell in Model.Cells)
            {
                <div class="barcode-card">
                    <div class="barcode-label">Ячейка @cell.Address</div>
                    <svg id="barcode-cell-@cell.Address" class="barcode-image"></svg>
                    <div class="barcode-code">Адрес: @cell.Address</div>
                    <div style="font-size: 12px; color: @(cell.IsOccupied ? "#4caf50" : "#ff9800");">
                        @(cell.IsOccupied ? "📦 Есть товар" : "🟡 Пустая")
                    </div>
                    <script>
                        try {
                            JsBarcode("#barcode-cell-@cell.Address", "@cell.Address", {
                                format: "CODE128",
                                width: 2,
                                height: 80,
                                displayValue: true,
                                fontSize: 14,
                                margin: 10
                            });
                        } catch(e) { console.log('Ошибка:', e); }
                    </script>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty">📭 Нет ячеек на складе</div>
    }
    <div class="section-title" style="border-bottom-color: #9c27b0;">📦 Упаковки на складе</div>
    @if (Model.Packages.Any())
    {
        <div class="barcode-grid">
            @foreach (var pkg in Model.Packages)
            {
                <div class="barcode-card" style="border: 2px solid #e8d5f5;">
                    <div class="barcode-label" style="color: #7b1fa2;">
                        📦 @pkg.Name
                        <span class="package-tag">@pkg.ItemsCount товаров</span>
                    </div>
                    <svg id="barcode-pkg-@pkg.Barcode" class="barcode-image"></svg>
                    <div class="barcode-code" style="color: #7b1fa2;">
                        Штрих-код: @pkg.Barcode
                    </div>
                    <div style="font-size: 12px; color: @(string.IsNullOrEmpty(pkg.CellAddress) ? "#ff9800" : "#4caf50");">
                        @(string.IsNullOrEmpty(pkg.CellAddress) ? "⚠️ Не размещена" : $"📍 {pkg.CellAddress}")
                    </div>
                    <div style="font-size: 11px; color: #999; margin-top: 5px;">
                        📅 @pkg.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </div>
                    <script>
                        try {
                            JsBarcode("#barcode-pkg-@pkg.Barcode", "@pkg.Barcode", {
                                format: "EAN13",
                                width: 2,
                                height: 80,
                                displayValue: true,
                                fontSize: 14,
                                margin: 10
                            });
                        } catch(e) { console.log('Ошибка:', e); }
                    </script>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty">📭 Нет упаковок на складе</div>
    }
    <script>
        function copyBarcode(text, element) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text)
                    .then(() => {
                        showCopyFeedback(element, '✅ Скопировано!');
                    })
                    .catch(() => {
                        fallbackCopy(text, element);
                    });
            } else {
                fallbackCopy(text, element);
            }
        }
        function showCopyFeedback(element, message) {
            const container = element.closest('.barcode-container') || element.closest('.barcode-wrapper') || element.parentElement;

            const tooltip = document.createElement('span');
            tooltip.textContent = message;
            tooltip.style.cssText = `
                position: absolute;
                background: #333;
                color: white;
                padding: 4px 12px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 500;
                margin-left: 8px;
                white-space: nowrap;
                animation: fadeInOut 1.5s ease forwards;
                z-index: 1000;
            `;

            if (!document.getElementById('copyTooltipStyles')) {
                const style = document.createElement('style');
                style.id = 'copyTooltipStyles';
                style.textContent = `
        @@keyframes fadeInOut {
                        0% { opacity: 0; transform: translateY(-5px); }
                        20% { opacity: 1; transform: translateY(0); }
                        80% { opacity: 1; transform: translateY(0); }
                        100% { opacity: 0; transform: translateY(-5px); }
                    }
                `;
                document.head.appendChild(style);
            }

            const rect = element.getBoundingClientRect();
            tooltip.style.position = 'fixed';
            tooltip.style.top = (rect.top - 30) + 'px';
            tooltip.style.left = (rect.left + rect.width / 2 - 60) + 'px';

            document.body.appendChild(tooltip);

            setTimeout(() => {
                if (tooltip.parentNode) tooltip.remove();
            }, 1500);
        }
    </script>
</body>
</html>