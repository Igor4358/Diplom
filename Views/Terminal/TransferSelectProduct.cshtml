@{
    Layout = null;
}
@model dynamic

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <title>Выбор объекта - ТСД Автосклад</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            max-width: 480px;
            width: 100%;
            margin: 0 auto;
        }

        .card {
            background: white;
            border-radius: 24px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        h2 {
            color: #333;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #666;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .cell-title {
            background: #e8f0fe;
            padding: 12px;
            border-radius: 12px;
            font-size: 18px;
            font-weight: bold;
            color: #667eea;
            margin-bottom: 20px;
        }

        .product-btn {
            width: 100%;
            padding: 16px;
            background: #f8f9fa;
            border: 2px solid #ddd;
            border-radius: 12px;
            font-size: 16px;
            cursor: pointer;
            margin: 8px 0;
            text-align: left;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .product-btn:active {
                background: #e0e0e0;
                transform: scale(0.98);
            }

        .product-name {
            font-weight: bold;
        }

        .product-sku {
            color: #999;
            font-size: 12px;
        }

        .product-qty {
            background: #4caf50;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
        }

        .back-btn {
            background: #999;
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-size: 16px;
            cursor: pointer;
            width: 100%;
            margin-top: 12px;
        }

            .back-btn:active {
                transform: scale(0.98);
            }

        .section-title {
            margin-top: 15px;
            font-weight: bold;
            color: #333;
            text-align: left;
        }

        .empty {
            color: #999;
            padding: 20px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h2>📦 Выбор объекта</h2>
            <div class="subtitle">Выберите товар или упаковку для перемещения</div>

            <div class="cell-title">📍 Ячейка @ViewBag.CellAddress</div>

            @if (ViewBag.Stocks != null && ((IEnumerable<dynamic>)ViewBag.Stocks).Any())
            {
                <div class="section-title">📦 Товары:</div>
                @foreach (var stock in ViewBag.Stocks)
                {
                    <form method="post" asp-action="TransferSelectProduct" style="margin:0;">
                        <input type="hidden" name="stockId" value="@stock.Id">
                        <button type="submit" class="product-btn">
                            <div>
                                <div class="product-name">@stock.Product?.Name</div>
                                <div class="product-sku">Артикул: @stock.Product?.Sku</div>
                            </div>
                            <div class="product-qty">@stock.Quantity шт</div>
                        </button>
                    </form>
                }
            }

            @if (ViewBag.Packages != null && ((IEnumerable<dynamic>)ViewBag.Packages).Any())
            {
                <div class="section-title" style="color: #9c27b0;">📦 Упаковки:</div>
                @foreach (var package in ViewBag.Packages)
                {
                    var itemsCount = 0;
                    if (package.Items != null)
                    {
                        foreach (var item in package.Items)
                        {
                            itemsCount += item.Quantity;
                        }
                    }
                    <form method="post" asp-action="TransferSelectPackage" style="margin:0;">
                        <input type="hidden" name="packageId" value="@package.Id">
                        <button type="submit" class="product-btn" style="border-color: #9c27b0;">
                            <div>
                                <div class="product-name" style="color: #9c27b0;">📦 @package.Barcode</div>
                                <div class="product-sku">@package.Name</div>
                            </div>
                            <div class="product-qty" style="background: #9c27b0;">@itemsCount шт</div>
                        </button>
                    </form>
                }
            }

            @if ((ViewBag.Stocks == null || !((IEnumerable<dynamic>)ViewBag.Stocks).Any()) &&
            (ViewBag.Packages == null || !((IEnumerable<dynamic>)ViewBag.Packages).Any()))
            {
                <div class="empty">📭 В ячейке нет товаров или упаковок</div>
            }

            <button class="back-btn" onclick="location.href='/Terminal/TransferBetweenWarehouses'">← Назад</button>
        </div>
    </div>
</body>
</html>