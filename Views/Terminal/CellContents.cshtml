@{
    Layout = null;
}
@model List<WMS.Terminal.Models.Stock>
@using WMS.Terminal.Models

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Содержимое ячейки - ТСД Автосклад</title>

    <script src="https://unpkg.com/html5-qrcode"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
        }

        .card {
            background: white;
            border-radius: 24px;
            padding: 25px 20px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        h2 {
            color: #333;
            margin-bottom: 15px;
            font-size: 22px;
        }

        .error {
            background: #fee;
            color: #c33;
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .info {
            background: #d4edda;
            color: #155724;
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .back-btn {
            background: #999;
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-size: 16px;
            cursor: pointer;
            width: 100%;
            margin-top: 12px;
        }

            .back-btn:active {
                transform: scale(0.98);
            }

        .scan-input {
            width: 100%;
            padding: 18px;
            font-size: 22px;
            text-align: center;
            border: 2px solid #ddd;
            border-radius: 12px;
            background: #fafafa;
            margin-bottom: 12px;
        }

            .scan-input:focus {
                outline: none;
                border-color: #667eea;
                background: white;
            }

        .scan-btn {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 18px;
            cursor: pointer;
            margin-bottom: 12px;
        }

            .scan-btn:active {
                transform: scale(0.97);
            }

        .scan-btn-stop {
            background: #ff4444;
        }

        #reader {
            width: 100%;
            max-width: 480px;
            margin: 10px auto;
            border-radius: 16px;
            overflow: hidden;
            background: #000;
        }

            #reader video {
                width: 100%;
                height: auto;
                display: block;
            }

        .submit-btn {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 18px;
            cursor: pointer;
            margin-top: 5px;
        }

            .submit-btn:active {
                transform: scale(0.97);
            }

        .stop-scan-btn {
            width: 100%;
            padding: 14px;
            background: #ff4444;
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 18px;
            cursor: pointer;
            margin-top: 10px;
            display: none;
        }

            .stop-scan-btn:active {
                transform: scale(0.97);
            }

        .cell-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px;
            border-radius: 12px;
            margin: 15px 0;
            font-size: 18px;
        }

        .product-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            border-bottom: 1px solid #eee;
        }

        .product-name {
            font-weight: bold;
            color: #333;
        }

        .product-sku {
            color: #999;
            font-size: 12px;
        }

        .product-qty {
            background: #4caf50;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 14px;
        }

        .empty-message {
            color: #999;
            padding: 30px 0;
        }

        .barcode-section {
            margin-top: 20px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 12px;
        }

        .barcode-section-title {
            font-weight: bold;
            margin-bottom: 10px;
            color: #333;
        }

        .barcode-image {
            width: 100%;
            max-width: 280px;
            height: auto;
            margin: 0 auto;
            display: block;
        }

        .barcode-hint {
            font-size: 12px;
            color: #999;
            margin-top: 8px;
        }

        .copy-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 4px;
            color: #667eea;
            transition: background-color 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .copy-btn:hover {
                background-color: #e8f0fe;
            }

            .copy-btn:active {
                transform: scale(0.8);
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h2>📦 Содержимое ячейки</h2>

            @if (ViewBag.Error != null)
            {
                <div class="error">❌ @ViewBag.Error</div>
            }
            @if (ViewBag.Info != null)
            {
                <div class="info">ℹ️ @ViewBag.Info</div>
            }

            <form method="get" id="cellForm">
                <input type="text" name="cellAddress" id="cellAddress" class="scan-input" placeholder="Адрес ячейки (например, 406a231)" value="@ViewBag.CellAddress" autofocus>
                <button type="button" id="scanButton" class="scan-btn">📷 Сканировать QR-код ячейки</button>
                <div id="reader" style="display:none;"></div>
                <button type="button" id="stopScanBtn" class="stop-scan-btn">⏹ Остановить сканер</button>
                <button type="submit" class="submit-btn">🔍 Показать</button>
            </form>
            @if (ViewBag.CellAddress != null)
            {
                <div class="cell-header">📍 Ячейка @ViewBag.CellAddress</div>

                @if (Model.Any())
                {
                    @foreach (var stock in Model)
                    {
                        <div class="product-item">
                            <div>
                                <div class="product-name">@stock.Product?.Name</div>
                                <div class="product-sku">Артикул: @stock.Product?.Sku</div>
                                <div class="product-sku" style="font-size: 10px; color: #667eea;">Штрих-код: @stock.Barcode
                                    <button class="copy-btn" onclick="copyBarcode('@stock.Barcode', this)" title="Скопировать штрих-код">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            <div class="product-qty">@stock.Quantity шт</div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-message">📭 Ячейка пуста</div>
                }
            }
            @if (ViewBag.Packages != null)
            {
                var packages = ViewBag.Packages as List<Package>;
                if (packages != null && packages.Any())
                {
                    <div class="package-section">
                        <div class="package-section-title">📦 Упаковки в ячейке:</div>
                        @foreach (var pkg in packages)
                        {
                            var totalItems = pkg.Items?.Sum(i => i.Quantity) ?? 0;
                            <div class="package-item">
                                <div>
                                    <div class="package-barcode">📦 @pkg.Barcode</div>
                                    <div class="package-items-count">Товаров: @totalItems</div>
                                </div>
                                <button class="package-view-btn" onclick="location.href='/Terminal/PackageContents?barcode=@pkg.Barcode'">
                                    🔍 Смотреть
                                </button>
                            </div>
                        }
                    </div>
                }
            }
            <button class="back-btn" onclick="location.href='/Terminal/MainMenu'">← Главное меню</button>
            <button class="back-btn" onclick="history.back()">← Назад</button>
        </div>
    </div>

    <script>
        let html5Scanner = null;
        let isScanning = false;
        const scanBtn = document.getElementById('scanButton');
        const stopBtn = document.getElementById('stopScanBtn');
        const inputField = document.getElementById('cellAddress');
        const readerContainer = document.getElementById('reader');

        function startScanner() {
            if (typeof Html5Qrcode === 'undefined') {
                alert('Библиотека сканера не загружена.');
                return;
            }
            readerContainer.style.display = 'block';
            scanBtn.textContent = '⏳ Запуск...';
            scanBtn.disabled = true;

            html5Scanner = new Html5Qrcode("reader");
            const config = { fps: 15, qrbox: { width: 250, height: 100 }, aspectRatio: 1.0 };

            html5Scanner.start(
                { facingMode: "environment" },
                config,
                (decodedText) => {
                    inputField.value = decodedText;
                    if (navigator.vibrate) navigator.vibrate(200);
                    stopScanner();
                    const form = document.getElementById('cellForm');
                    if (form) setTimeout(() => form.submit(), 300);
                },
                (error) => {}
            ).then(() => {
                isScanning = true;
                scanBtn.textContent = '⏹ Остановить сканер';
                scanBtn.disabled = false;
                scanBtn.classList.add('scan-btn-stop');
                stopBtn.style.display = 'block';
            }).catch((err) => {
                alert('Ошибка камеры: ' + err);
                readerContainer.style.display = 'none';
                scanBtn.textContent = '📷 Сканировать QR-код ячейки';
                scanBtn.disabled = false;
                scanBtn.classList.remove('scan-btn-stop');
                stopBtn.style.display = 'none';
            });
        }

        function stopScanner() {
            if (html5Scanner) {
                html5Scanner.stop().then(() => {
                    html5Scanner.clear();
                    readerContainer.style.display = 'none';
                    isScanning = false;
                    scanBtn.textContent = '📷 Сканировать QR-код ячейки';
                    scanBtn.disabled = false;
                    scanBtn.classList.remove('scan-btn-stop');
                    stopBtn.style.display = 'none';
                    html5Scanner = null;
                }).catch(() => {});
            } else {
                readerContainer.style.display = 'none';
                isScanning = false;
                scanBtn.textContent = '📷 Сканировать QR-код ячейки';
                scanBtn.disabled = false;
                scanBtn.classList.remove('scan-btn-stop');
                stopBtn.style.display = 'none';
            }
        }

        scanBtn.addEventListener('click', function() {
            if (isScanning) stopScanner(); else startScanner();
        });
        stopBtn.addEventListener('click', stopScanner);
        inputField.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                const form = this.closest('form');
                if (form) form.submit();
            }
        });
        window.addEventListener('beforeunload', stopScanner);
        console.log('✅ Сканер для ячейки загружен');
    </script>
    <script>
        function copyBarcode(text, element) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text)
                    .then(() => {
                        showCopyFeedback(element, '✅ Скопировано!');
                    })
                    .catch(() => {
                        fallbackCopy(text, element);
                    });
            } else {
                fallbackCopy(text, element);
            }
        }
        function showCopyFeedback(element, message) {
            const container = element.closest('.barcode-container') || element.closest('.barcode-wrapper') || element.parentElement;

            const tooltip = document.createElement('span');
            tooltip.textContent = message;
            tooltip.style.cssText = `
                position: absolute;
                background: #333;
                color: white;
                padding: 4px 12px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 500;
                margin-left: 8px;
                white-space: nowrap;
                animation: fadeInOut 1.5s ease forwards;
                z-index: 1000;
            `;

            if (!document.getElementById('copyTooltipStyles')) {
                const style = document.createElement('style');
                style.id = 'copyTooltipStyles';
                style.textContent = `
        @@keyframes fadeInOut {
                        0% { opacity: 0; transform: translateY(-5px); }
                        20% { opacity: 1; transform: translateY(0); }
                        80% { opacity: 1; transform: translateY(0); }
                        100% { opacity: 0; transform: translateY(-5px); }
                    }
                `;
                document.head.appendChild(style);
            }

            const rect = element.getBoundingClientRect();
            tooltip.style.position = 'fixed';
            tooltip.style.top = (rect.top - 30) + 'px';
            tooltip.style.left = (rect.left + rect.width / 2 - 60) + 'px';

            document.body.appendChild(tooltip);

            setTimeout(() => {
                if (tooltip.parentNode) tooltip.remove();
            }, 1500);
        }
    </script>
</body>
</html>