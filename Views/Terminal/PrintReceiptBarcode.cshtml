@{
    Layout = null;
}
@model WMS.Terminal.Models.ExpectedReceipt

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <title>Печать штрих-кода поставки - ТСД Автопитер</title>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f5f5f5;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            max-width: 500px;
            width: 100%;
            margin: 0 auto;
        }

        .card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }

        .back-btn {
            background: #999;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 16px;
            cursor: pointer;
            width: 100%;
            margin-top: 15px;
        }

            .back-btn:active {
                transform: scale(0.98);
            }

        .print-btn {
            background: #28a745;
            color: white;
            border: none;
            padding: 14px 20px;
            border-radius: 12px;
            font-size: 18px;
            cursor: pointer;
            width: 100%;
            margin: 15px 0;
        }

            .print-btn:active {
                transform: scale(0.98);
            }

        h2 {
            color: #333;
            margin-bottom: 5px;
        }

        .subtitle {
            color: #666;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .barcode-container {
            background: white;
            padding: 20px;
            border: 2px dashed #ddd;
            border-radius: 16px;
            margin: 20px 0;
        }

            .barcode-container svg {
                max-width: 100%;
                height: auto;
            }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

        .info-label {
            color: #666;
        }

        .info-value {
            font-weight: bold;
            color: #333;
        }

        .info-box {
            text-align: left;
            margin: 15px 0;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .status-pending {
            background: #ff9800;
            color: white;
        }

        .status-partial {
            background: #2196f3;
            color: white;
        }

        .status-completed {
            background: #4caf50;
            color: white;
        }

        .no-print {
        }

        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .no-print {
                display: none !important;
            }

            .card {
                box-shadow: none;
                padding: 10px;
            }

            .barcode-container {
                border: none;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h2>🏷️ Штрих-код поставки</h2>
            <div class="subtitle">Этикетка для товара @Model.ProductName</div>

            <div class="barcode-container">
                <svg id="barcodeImage" style="width:100%; max-width:300px; height:auto;"></svg>
                <div style="font-family: monospace; font-size: 14px; color: #667eea; margin-top: 10px; word-break: break-all;">
                    @Model.Barcode
                </div>
            </div>

            <div class="info-box">
                <div class="info-row">
                    <span class="info-label">📦 Товар</span>
                    <span class="info-value">@Model.ProductName</span>
                </div>
                <div class="info-row">
                    <span class="info-label">🔢 Артикул</span>
                    <span class="info-value">@Model.Sku</span>
                </div>
                <div class="info-row">
                    <span class="info-label">📊 Ожидается</span>
                    <span class="info-value">@Model.ExpectedQuantity шт</span>
                </div>
                <div class="info-row">
                    <span class="info-label">📥 Принято</span>
                    <span class="info-value">@Model.ReceivedQuantity шт</span>
                </div>
                <div class="info-row">
                    <span class="info-label">📌 Статус</span>
                    <span class="info-value">
                        <span class="status-badge
                              @(Model.Status == "Completed" ? "status-completed" :
                                Model.Status == "Partial" ? "status-partial" : "status-pending")">
                              @(Model.Status == "Pending" ? "Ожидает" :
                                Model.Status == "Partial" ? "Частично" :
                                Model.Status == "Completed" ? "Завершена" : Model.Status)
                        </span>
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Supplier))
                {
                    <div class="info-row">
                        <span class="info-label">🏭 Поставщик</span>
                        <span class="info-value">@Model.Supplier</span>
                    </div>
                }
                <div class="info-row">
                    <span class="info-label">📅 Дата</span>
                    <span class="info-value">@Model.ExpectedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                </div>
            </div>

            <button class="print-btn no-print" onclick="window.print()">🖨️ Печать этикетки</button>
            <button class="back-btn no-print" onclick="location.href='/Terminal/ExpectedReceipts'">← Назад к поставкам</button>
        </div>
    </div>

    <script>
        try {
            JsBarcode("#barcodeImage", "@Model.Barcode", {
                format: "CODE128",
                width: 2,
                height: 100,
                displayValue: false,
                margin: 10
            });
        } catch(e) {
            console.log('Ошибка генерации штрих-кода:', e);
        }
    </script>
</body>
</html>