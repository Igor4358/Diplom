@{
    Layout = null;
}
@model List<WMS.Terminal.Models.ExpectedReceipt>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <title>Ожидаемые поставки - ТСД Автосклад</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f5f5f5;
            padding: 20px;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            margin: -20px -20px 20px -20px;
            padding: 20px;
            color: white;
        }

        .back-btn {
            background: rgba(255,255,255,0.2);
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            color: white;
            margin-bottom: 10px;
            cursor: pointer;
        }

        h1 {
            font-size: 24px;
        }

        .receipt-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 15px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .receipt-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .receipt-product {
            font-size: 18px;
            font-weight: bold;
            color: #333;
        }

        .receipt-sku {
            color: #999;
            font-size: 14px;
        }

        .receipt-details {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin: 10px 0;
        }

            .receipt-details span {
                background: #f0f0f0;
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 14px;
            }

        .status-pending {
            background: #ff9800;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
        }

        .status-partial {
            background: #2196f3;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
        }

        .status-completed {
            background: #4caf50;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
        }

        .empty {
            text-align: center;
            padding: 50px;
            color: #999;
            background: white;
            border-radius: 16px;
        }

        .add-btn {
            background: #28a745;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 16px;
            cursor: pointer;
            margin: 15px 0;
            width: 100%;
        }

            .add-btn:active {
                transform: scale(0.98);
            }

        .barcode-display {
            font-family: monospace;
            font-size: 12px;
            color: #667eea;
            margin-top: 5px;
        }

        .progress-bar {
            width: 100%;
            height: 6px;
            background: #eee;
            border-radius: 3px;
            margin-top: 10px;
        }

        .progress-fill {
            height: 100%;
            border-radius: 3px;
            background: #4caf50;
        }

        .copy-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 4px;
            color: #667eea;
            transition: background-color 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .copy-btn:hover {
                background-color: #e8f0fe;
            }

            .copy-btn:active {
                transform: scale(0.9);
            }
    </style>
</head>
<body>
    <div class="header">
        <button class="back-btn" onclick="location.href='/Terminal/MainMenu'">← Назад</button>
        <h1>📋 Ожидаемые поставки</h1>
    </div>

    <button class="add-btn" onclick="location.href='/Terminal/AddExpectedReceipt'">
        ➕ Добавить ожидаемую поставку
    </button>

    @if (Model.Any())
    {
        foreach (var item in Model)
        {
            var percent = item.ExpectedQuantity > 0
            ? (item.ReceivedQuantity * 100 / item.ExpectedQuantity)
            : 0;
            var statusClass = item.Status == "Completed" ? "status-completed" :
            (item.Status == "Partial" ? "status-partial" : "status-pending");

            <div class="receipt-card">
                <div class="receipt-header">
                    <div>
                        <div class="receipt-product">@item.ProductName</div>
                        <div class="receipt-sku">Артикул: @item.Sku</div>
                        <div class="barcode-display">Штрих-код: @item.Barcode
                            <button class="copy-btn" onclick="copyBarcode('@item.Barcode', this)" title="Скопировать штрих-код">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                </svg>
                            </button>
                        </div>

                    </div>
                    <span class="status-@item.Status.ToLower()">
                        @{
                            var status = item.Status switch
                            {
                                "Pending" => "В ожидании",
                                "Partial" => "Частично",
                                "Completed" => "Завершена",
                                _ => item.Status
                            };
                        }
                        @status
                    </span>
                </div>

                <div class="receipt-details">
                    <span>📦 Ожидается: @item.ExpectedQuantity шт</span>
                    <span>📥 Принято: @item.ReceivedQuantity шт</span>
                    <span>📅 @item.ExpectedDate.ToString("dd.MM.yyyy")</span>
                    @if (!string.IsNullOrEmpty(item.Supplier))
                    {
                        <span>🏭 @item.Supplier</span>
                    }
                    <span>📍 Склад: <strong>@(item.Warehouse?.Name ?? "Не указан")</strong></span>
                    <div class="action-buttons">
                        <button class="btn-print" onclick="location.href='/Terminal/PrintReceiptBarcode?id=@item.Id'">
                            🏷️ Печать штрих-кода
                        </button>
                </div>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @percent%;"></div>
                </div>
                <div style="font-size: 12px; color: #999; margin-top: 5px;">Прогресс: @percent%</div>
            </div>
        }
    }
    else
    {
        <div class="empty">
            📭 Нет ожидаемых поставок<br>
            <small>Нажмите "Добавить ожидаемую поставку" для создания</small>
        </div>
        <button class="add-btn" style="background:#667eea;" onclick="location.href='/Terminal/CompletedReceipts'">
            📋 Показать завершённые поставки
        </button>
    }
    <script>
        function copyBarcode(text, element) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text)
                    .then(() => {
                        showCopyFeedback(element, '✅ Скопировано!');
                    })
                    .catch(() => {
                        fallbackCopy(text, element);
                    });
            } else {
                fallbackCopy(text, element);
            }
        }
        function showCopyFeedback(element, message) {
            const container = element.closest('.barcode-container') || element.closest('.barcode-wrapper') || element.parentElement;

            const tooltip = document.createElement('span');
            tooltip.textContent = message;
            tooltip.style.cssText = `
                position: absolute;
                background: #333;
                color: white;
                padding: 4px 12px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 500;
                margin-left: 8px;
                white-space: nowrap;
                animation: fadeInOut 1.5s ease forwards;
                z-index: 1000;
            `;

            if (!document.getElementById('copyTooltipStyles')) {
                const style = document.createElement('style');
                style.id = 'copyTooltipStyles';
                style.textContent = `
        @@keyframes fadeInOut {
                        0% { opacity: 0; transform: translateY(-5px); }
                        20% { opacity: 1; transform: translateY(0); }
                        80% { opacity: 1; transform: translateY(0); }
                        100% { opacity: 0; transform: translateY(-5px); }
                    }
                `;
                document.head.appendChild(style);
            }

            const rect = element.getBoundingClientRect();
            tooltip.style.position = 'fixed';
            tooltip.style.top = (rect.top - 30) + 'px';
            tooltip.style.left = (rect.left + rect.width / 2 - 60) + 'px';

            document.body.appendChild(tooltip);

            setTimeout(() => {
                if (tooltip.parentNode) tooltip.remove();
            }, 1500);
        }
    </script>
</body>
</html>