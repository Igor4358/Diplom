@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <title>Перемещение между складами - ТСД Автосклад</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            max-width: 480px;
            width: 100%;
            margin: 0 auto;
        }

        .card {
            background: white;
            border-radius: 24px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        h2 {
            color: #333;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #666;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .success {
            background: #d4edda;
            color: #155724;
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .error {
            background: #fee;
            color: #c33;
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .action-btn {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 18px;
            cursor: pointer;
            margin: 10px 0;
        }

            .action-btn:active {
                transform: scale(0.98);
            }

        .back-btn {
            background: #999;
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-size: 16px;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
        }

            .back-btn:active {
                transform: scale(0.98);
            }

        .info-text {
            font-size: 14px;
            color: #666;
            margin: 15px 0;
        }

        .steps {
            text-align: left;
            padding: 10px 0;
        }

            .steps li {
                padding: 8px 0;
                color: #555;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h2>🔄 Перемещение между складами</h2>
            <div class="subtitle">Переместите товар на другой склад</div>

            @if (TempData["TransferSuccess"] != null)
            {
                <div class="success">✅ @TempData["TransferSuccess"]</div>
            }
            @if (TempData["TransferError"] != null)
            {
                <div class="error">❌ @TempData["TransferError"]</div>
            }
            @if (TempData["PackageSuccess"] != null)
            {
                <div class="success">✅ @TempData["PackageSuccess"]</div>
            }
            @if (TempData["PackageError"] != null)
            {
                <div class="error">❌ @TempData["PackageError"]</div>
            }

            <div class="info-text">
                <strong>Инструкция:</strong>
                <ol class="steps">
                    <li>📌 Отсканируйте ячейку с товаром</li>
                    <li>📦 Выберите товар и количество</li>
                    <li>🏭 Выберите склад-получатель</li>
                    <li>✅ Подтвердите перемещение</li>
                </ol>
            </div>

            <button class="action-btn" onclick="location.href='/Terminal/TransferScanCell'">
                📌 Начать перемещение
            </button>

            <button class="back-btn" onclick="location.href='/Terminal/MainMenu'">← Главное меню</button>
            <button class="back-btn" onclick="history.back()">← Назад</button>
        </div>
    </div>
</body>
</html>