@{
    Layout = null;
}
@model List<WMS.Terminal.Models.Cell>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <title>Выбор ячейки - ТСД Автосклад</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            max-width: 480px;
            width: 100%;
            margin: 0 auto;
        }

        .card {
            background: white;
            border-radius: 24px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        h2 {
            color: #333;
            margin-bottom: 10px;
        }

        .product-info {
            background: #f0f0f0;
            padding: 15px;
            border-radius: 16px;
            margin: 15px 0;
        }

            .product-info .label {
                color: #666;
                font-size: 12px;
            }

            .product-info .value {
                font-size: 18px;
                font-weight: bold;
                color: #333;
            }

        .cell-list {
            margin: 20px 0;
            max-height: 300px;
            overflow-y: auto;
        }

        .cell-btn {
            display: block;
            width: 100%;
            padding: 15px;
            margin: 8px 0;
            background: #f8f9fa;
            border: 2px solid #ddd;
            border-radius: 12px;
            font-size: 18px;
            font-weight: bold;
            text-align: center;
            cursor: pointer;
        }

            .cell-btn:active {
                background: #e0e0e0;
                transform: scale(0.98);
            }

            .cell-btn.selected {
                background: #667eea;
                color: white;
                border-color: #667eea;
            }

        .qty-input {
            width: 100%;
            padding: 15px;
            font-size: 18px;
            text-align: center;
            border: 2px solid #ddd;
            border-radius: 12px;
            margin: 15px 0;
        }

            .qty-input:focus {
                outline: none;
                border-color: #667eea;
            }

        .submit-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 16px;
            border-radius: 12px;
            font-size: 18px;
            cursor: pointer;
            width: 100%;
        }

            .submit-btn:disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

        .back-btn {
            background: #999;
            color: white;
            border: none;
            padding: 16px;
            border-radius: 12px;
            font-size: 18px;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
        }

        .error {
            background: #fee;
            color: #c33;
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .max-hint {
            font-size: 14px;
            color: #666;
            margin: 10px 0;
        }

            .max-hint strong {
                color: #667eea;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h2>📍 Размещение товара</h2>

            <div class="product-info">
                <div class="label">Товар</div>
                <div class="value">@ViewBag.ProductName</div>
                <div style="font-size:14px; color:#999; margin-top:5px;">Артикул: @ViewBag.ProductSku</div>
            </div>

            @if (ViewBag.MaxQuantity != null && ViewBag.MaxQuantity > 0)
            {
                <div class="max-hint">
                    📦 Можно принять: <strong>@ViewBag.MaxQuantity шт</strong>
                </div>
            }

            <form method="post" action="/Terminal/ConfirmReceiving" id="placementForm">
                <input type="hidden" name="cellId" id="selectedCellId" value="">

                <div class="cell-list">
                    <div style="margin-bottom: 10px; color: #666; font-size: 14px;">Выберите ячейку:</div>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var cell in Model)
                        {
                            <button type="button" class="cell-btn" data-cell-id="@cell.Id" data-cell-addr="@cell.Address">
                                📦 @cell.Address
                            </button>
                        }
                    }
                    else
                    {
                        <div style="text-align: center; padding: 20px; color: #999;">
                            ⚠️ Нет доступных ячеек
                        </div>
                    }
                </div>

                <input type="number" name="quantity" id="quantity" class="qty-input"
                       placeholder="Количество" value="1" min="1"
                       max="@(ViewBag.MaxQuantity ?? 999)">

                <button type="submit" class="submit-btn" id="submitBtn" disabled>
                    ✅ Подтвердить размещение
                </button>
            </form>

            <button class="back-btn" onclick="location.href='/Terminal/Receiving'">← Назад</button>
        </div>
    </div>

    <script>
        let selectedCellId = null;
        const maxQty = @(ViewBag.MaxQuantity ?? 999);
        const qtyInput = document.getElementById('quantity');

        qtyInput.addEventListener('change', function() {
            if (parseInt(this.value) > maxQty) {
                this.value = maxQty;
                alert('Нельзя принять больше ' + maxQty + ' шт!');
            }
            if (parseInt(this.value) < 1) this.value = 1;
        });

        qtyInput.addEventListener('input', function() {
            if (parseInt(this.value) > maxQty) {
                this.value = maxQty;
            }
        });

        document.querySelectorAll('.cell-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.cell-btn').forEach(b => b.classList.remove('selected'));
                this.classList.add('selected');
                selectedCellId = this.getAttribute('data-cell-id');
                document.getElementById('selectedCellId').value = selectedCellId;
                document.getElementById('submitBtn').disabled = false;
            });
        });
    </script>
</body>
</html>